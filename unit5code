import heapq
city_map = {
    "A": [("B", 4), ("C", 2)],
    "B": [("A", 4), ("C", 1), ("D", 5)],
    "C": [("A", 2), ("B", 1), ("D", 8), ("E", 10)],
    "D": [("B", 5), ("C", 8), ("E", 2), ("F", 6)],
    "E": [("C", 10), ("D", 2), ("F", 3)],
    "F": [("D", 6), ("E", 3)]
}
def dijkstra(graph, start, destination):
    if start not in graph or destination not in graph:
        print("Location not found!")
        return

    distances = {location: float("inf") for location in graph}
    previous = {location: None for location in graph}

    distances[start] = 0
    priority_queue = [(0, start)]

    while priority_queue:
        current_distance, current = heapq.heappop(priority_queue)

        if current_distance > distances[current]:
            continue

        if current == destination:
            break

        for neighbor, distance in graph[current]:
            new_distance = current_distance + distance

            if new_distance < distances[neighbor]:
                distances[neighbor] = new_distance
                previous[neighbor] = current
                heapq.heappush(
                    priority_queue, (new_distance, neighbor)
                )

    if distances[destination] == float("inf"):
        print("No route available between these locations.")
        return

    path = []
    current = destination

    while current is not None:
        path.append(current)
        current = previous[current]

    path.reverse()

    print("\nShortest Route:", " -> ".join(path))
    print("Total Distance:", distances[destination], "km")

while True:
    print("\nCITY NAVIGATION SYSTEM")
    print("Available Locations:", ", ".join(city_map.keys()))
    print("1. Find Shortest Path")
    print("2. Display City Map")
    print("3. Exit")
    choice = input("Enter your choice: ")
    if choice == "1":
        start = input("Enter starting location: ").strip().upper()
        destination = input("Enter destination: ").strip().upper()
        dijkstra(city_map, start, destination)

    elif choice == "2":
        print("\nCity Map (Location: Connected Locations and Distance)")
        for location, roads in city_map.items():
            print(location, ":", roads)

    elif choice == "3":
        print("Thank you for using City Navigation System!")
        break

    else:
        print("Invalid choice! Please try again.")
