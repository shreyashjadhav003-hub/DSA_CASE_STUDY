
class Node:
    def __init__(self, book):
        self.book = book
        self.next = None

class BookHistory:
    def __init__(self):
        self.top = None
    def view_book(self, book):
        new_node = Node(book)
        new_node.next = self.top
        self.top = new_node
        print("Book viewed:", book)
    def previous_book(self):
        if self.top is None:
            print("No book history available!")
        elif self.top.next is None:
            print("No previous book available!")
        else:
            self.top = self.top.next
            print("Previous Book:", self.top.book)
    def current_book(self):
        if self.top is None:
            print("No book currently viewed!")
        else:
            print("Current Book:", self.top.book)
    def display_history(self):
        if self.top is None:
            print("Book history is empty!")
            return
        current = self.top
        print("\nBook History (Latest to Oldest):")
        while current:
            print(current.book)
            current = current.next
history = BookHistory()
while True:
    print("\nBOOK HISTORY TRACKING SYSTEM")
    print("1. View Book")
    print("2. Go Back to Previous Book")
    print("3. Display Book History")
    print("4. Show Current Book")
    print("5. Exit")
    choice = input("Enter your choice: ")
    if choice == "1":
        book = input("Enter Book Name: ").strip()
        if book:
            history.view_book(book)
        else:
            print("Book name cannot be empty!")
    elif choice == "2":
        history.previous_book()
    elif choice == "3":
        history.display_history()

    elif choice == "4":
        history.current_book()

    elif choice == "5":
        print("Thank you for using Book History System!")
        break

    else:
        print("Invalid choice! Try again.")
